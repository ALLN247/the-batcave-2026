# Environment for the NotebookLM MCP server.
# Install to /etc/notebooklm-mcp.env with mode 0600 — this file holds a secret.
#
# NOTE: systemd EnvironmentFile does NOT do shell expansion. Write literal
# values, and do not quote them unless the quotes are part of the value.

NOTEBOOKLM_MCP_TRANSPORT=http
NOTEBOOKLM_MCP_HOST=127.0.0.1
NOTEBOOKLM_MCP_PORT=9420

# Bind stays on loopback above because Cloudflare Tunnel / Caddy connects locally.
# Only if you bind directly to a public interface, uncomment:
# NOTEBOOKLM_MCP_HOST=0.0.0.0
# NOTEBOOKLM_MCP_ALLOW_EXTERNAL_BIND=1

# --- OAuth (required for claude.ai) ---------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 16 chars (enforced at startup). Use 32+.
NOTEBOOKLM_MCP_OAUTH_PASSWORD=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Bare https origin — NO path. The connector URL you paste into claude.ai is
# this value plus /mcp.
NOTEBOOKLM_MCP_OAUTH_BASE_URL=https://notebooklm.yourdomain.com

# Set ONLY when behind a proxy you control (Cloudflare, Caddy, nginx).
NOTEBOOKLM_MCP_TRUST_PROXY=1

# --- optional --------------------------------------------------------------
# NOTEBOOKLM_PROFILE=default
# NOTEBOOKLM_MCP_CHAT_CONCURRENCY=4
# NOTEBOOKLM_LOG_LEVEL=INFO
